# Server
API_PORT=5000
CORS_ORIGIN=http://localhost:5173

# MongoDB
# Local: mongodb://127.0.0.1:27017/asshash
MONGODB_URI=mongodb://127.0.0.1:27017/asshash

# SMTP (Email sending)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Email From
EMAIL_FROM="Asshash <your_email@gmail.com>"

# SSLCommerz Payment Gateway (sandbox credentials from the main asshash app)
# Set SSLCOMMERZ_IS_LIVE=true only in production
SSLCOMMERZ_STORE_ID=your_store_id
SSLCOMMERZ_STORE_PASSWORD=your_store_password
SSLCOMMERZ_IS_LIVE=false

# The public-facing URL where SSLCommerz can POST callbacks.
# In development, use ngrok or a deployed server. Example: https://abc.ngrok.io
# In production, set to your actual domain: https://api.yoursite.com
BACKEND_URL=http://localhost:5000
